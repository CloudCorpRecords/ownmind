# OwnMind configuration — copy to .env or export in your shell.

# --- Live mode: NVIDIA Nemotron on Nebius Token Factory -------------------
# Get this key from the Nebius Token Factory console after joining the free
# Nebius Builder Program (hackathon credits, no purchase necessary).
# Setting this ONE variable switches OwnMind from the local mock model to
# live Nemotron inference. Nothing else changes.
NEBIUS_API_KEY=

# OpenAI-compatible endpoint for Nebius Token Factory (default shown).
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# NVIDIA open model served by Token Factory. Verify the exact ID in the
# Token Factory model catalog (GET /v1/models); other Nemotron options
# spotted in the catalog include nvidia/Nemotron-3.5-Super-VL.
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct

# --- Local behaviour --------------------------------------------------------
# PORT=4173
# MEMORY_FILE=./data/memory.json   # your vault — a plain JSON file you own
# MODEL_MODE=mock                  # force mock mode even if a key is set
